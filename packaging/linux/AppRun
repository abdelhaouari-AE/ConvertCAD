#!/bin/sh
# AppImage entry point.
#   ConvertCAD-x86_64.AppImage [plan.pdf ...]       the application
#   ConvertCAD-x86_64.AppImage --cli plan.pdf ...   the command-line tool
HERE="$(dirname "$(readlink -f "$0")")"
APP="$HERE/usr/lib/convertcad"
if [ "$1" = "--cli" ]; then
    shift
    exec "$APP/ConvertCAD-cli" "$@"
fi
exec "$APP/ConvertCAD" "$@"
